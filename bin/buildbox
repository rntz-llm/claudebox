#!/bin/bash

set -euo pipefail

# Resolve the script path through symlinks before taking its directory. Without
# this, invoking a symlink to this script -- the obvious thing to do once bin/
# is meant to be on your PATH -- computes the wrong script_dir: the build context
# below ends up somewhere else entirely. macOS has no portable `readlink -f`.
script="${BASH_SOURCE[0]}"
links=0
while [[ -L "$script" ]]; do
    if (( ++links > 40 )); then
        echo "Refusing to run: ‘${BASH_SOURCE[0]}’ is more than 40 symlinks deep; a loop?" >&2
        exit 1
    fi
    target="$(readlink "$script")"
    case "$target" in
        /*) script="$target" ;;
        *)  script="$(cd "$(dirname "$script")" && pwd -P)/$target" ;;
    esac
done

# The build context is the repo root, one level up from bin/.
repo_dir="$(cd "$(dirname "$script")/.." && pwd -P)"

# Always builds; claudebox only calls this when the image is missing, but run
# directly this is how you rebuild on demand. Extra arguments are passed through
# to `container build` -- `--no-cache` and `--progress plain` are the useful
# ones; see BUILD_CACHING_IS_PROBLEMATIC.md for why you usually want the former.

build_options=(
    # Identity is passed in rather than committed, to keep it out of the repo.
    --build-arg GIT_USER_NAME="$(git config --get user.name || true)"
    --build-arg GIT_USER_EMAIL="$(git config --get user.email || true)"
    --tag claude
)

echo "Building ‘claude’ image..."
echo container build "${build_options[@]}" "$@"
(cd "$repo_dir" && container build "${build_options[@]}" "$@")
echo "... built ‘claude’ image!"
echo
