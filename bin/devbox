#!/usr/bin/python3 -I
"""Run a command against the current directory under a macOS sandbox, so that
repo-supplied code -- git hooks, build scripts, dependencies -- can't write
outside the repo, read anything outside a fixed allowlist, or talk to the
network. See DEVBOX.md.

The shebang is deliberate. `-I` (isolated) ignores PYTHONPATH/PYTHONHOME, drops
the user site directory, and keeps this script's own directory off sys.path;
the absolute interpreter path means an activated .venv or a pyenv shim -- both
of which are chosen by the directory you are standing in, which is the
directory you have decided not to trust -- cannot supply the interpreter that
decides what the sandbox means.
"""

import os
import subprocess
import sys
from datetime import datetime

PROG = os.path.basename(sys.argv[0])
SANDBOX_EXEC = "/usr/bin/sandbox-exec"
LOG = "/usr/bin/log"

USAGE = """\
usage: {prog} [options] [--] [command [args...]]

Runs command (default: $SHELL) under a sandbox profile that allows writes only
to the current directory and to temporary directories, denies reads of your
credentials and private data, and by default denies IP network access.

options:
  --network=yes|no     allow IP networking (default: no)
  --allow-read PATH    permit reads under PATH, overriding a deny (repeatable)
  --allow-write PATH   permit writes under PATH (repeatable)
  --why                report the sandbox denials the command caused, after it
                       exits. This is how you find out what to add.
  --print-profile      print the generated sandbox profile and exit
  -h, --help           this

Defaults are extended by two files, one path per line, '#' for a comment and a
leading '!' to reverse a default:
  {deny_read}
  {allow_write}

Option parsing stops at the first non-option argument, so flags meant for the
command need no --:  {prog} cargo test --release
"""


def die(msg):
    print("%s: %s" % (PROG, msg), file=sys.stderr)
    sys.exit(1)


class ResolveError(Exception):
    """A path that can't be turned into an absolute physical path. Fatal when
    the user named it explicitly, ignorable when it came from a default list."""


# ---------- PATHS ----------

def _split(p):
    """POSIX dirname/basename, which differ from os.path for trailing slashes
    and for bare names."""
    stripped = p.rstrip("/")
    if not stripped:
        return "/", "/"
    head, _, base = stripped.rpartition("/")
    if not head:
        head = "/" if p.startswith("/") else "."
    return head, base


def resolve(p):
    """Absolute physical path. Does not error if the file does not exist yet,
    but resolves its directory path fully.

    It's important that we fully resolve things because sandbox-exec/macOS
    Seatbelt matches the resolved physical path, so otherwise denying reads of
    a symlinked file wouldn't deny reads of that file.
    """
    original = p
    # A literal tilde, from a quoted argument the shell didn't expand.
    if p == "~":
        p = home()
    elif p.startswith("~/"):
        p = os.path.join(home(), p[2:])

    links = 0
    while os.path.islink(p):
        links += 1
        if links > 40:
            raise ResolveError(
                "‘%s’ is more than 40 symlinks deep; a loop?" % original)
        target = os.readlink(p)
        p = target if target.startswith("/") else os.path.join(_split(p)[0], target)

    if os.path.isdir(p):
        return os.path.realpath(p)

    head, base = _split(p)
    if not os.path.isdir(head):
        raise ResolveError("no such directory: %s" % head)
    head = os.path.realpath(head)
    return "/" + base if head == "/" else head + "/" + base


def reject_unquotable(p):
    """Profile paths are interpolated into a double-quoted SBPL string, and
    SBPL has no way to express a literal quote or backslash inside one."""
    if '"' in p or "\\" in p or "\n" in p:
        die("refusing path with a quote, backslash or newline: %s" % p)


def home():
    h = os.environ.get("HOME")
    if not h:
        die("HOME is not set.")
    return h


# ---------- ARGUMENTS ----------

def parse_args(argv):
    """Hand-rolled rather than argparse, which cannot express "stop at the
    first non-option argument" -- the property that lets you write
    `devbox cargo test --release` with no `--`. REMAINDER is buggy when the
    remainder starts with something option-shaped, and parse_known_args
    scatters the command's own flags into the unrecognised pile."""
    opts = {
        "network": "no",
        "extra_read": [],
        "extra_write": [],
        "print_profile": False,
        "why": False,
    }

    def value(i):
        """`--flag VALUE`; a trailing `--flag` with nothing after it yields the
        empty string, which the checks below turn into an error."""
        return (argv[i + 1], 2) if i + 1 < len(argv) else ("", 1)

    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--network":
            opts["network"], step = value(i)
        elif a.startswith("--network="):
            opts["network"], step = a[len("--network="):], 1
        elif a == "--allow-read":
            v, step = value(i)
            opts["extra_read"].append(v)
        elif a.startswith("--allow-read="):
            opts["extra_read"].append(a[len("--allow-read="):])
            step = 1
        elif a == "--allow-write":
            v, step = value(i)
            opts["extra_write"].append(v)
        elif a.startswith("--allow-write="):
            opts["extra_write"].append(a[len("--allow-write="):])
            step = 1
        elif a == "--why":
            opts["why"], step = True, 1
        elif a == "--print-profile":
            opts["print_profile"], step = True, 1
        elif a in ("-h", "--help"):
            sys.stdout.write(USAGE.format(
                prog=PROG,
                deny_read=os.path.join(config_dir(), "deny-read"),
                allow_write=os.path.join(config_dir(), "allow-write")))
            sys.exit(0)
        elif a == "--":
            i += 1
            break
        elif a.startswith("-"):
            die("unknown option ‘%s’ (see --help)." % a)
        else:
            break
        i += step

    return opts, argv[i:]


def config_dir():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home(), ".config")
    return os.path.join(xdg, "devbox")


def read_config(name, plain, reversed_):
    """One path per line; blank lines and lines starting with '#' ignored; a
    leading '!' reverses the default sense of the file, so a deny-read file can
    re-allow and an allow-write file can subtract. Returns (action, path) pairs
    in file order. A missing file is not an error.

    Only whole-line comments: a '#' is legal in a path, and silently truncating
    someone's allowlist at one would be the wrong kind of surprise."""
    rules = []
    try:
        with open(os.path.join(config_dir(), name)) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return rules
    except OSError as e:
        die("cannot read %s: %s" % (os.path.join(config_dir(), name), e))
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("!"):
            rules.append((reversed_, line[1:].strip()))
        else:
            rules.append((plain, line))
    return rules


def check_allow(flag, paths):
    """Vet the paths you asked for up front. An unresolvable allowlist entry
    would otherwise be dropped and reappear later as a mysterious denial."""
    for p in paths:
        if not p:
            die("%s needs a path." % flag)
        try:
            resolve(p)
        except ResolveError as e:
            die(e)


# ---------- POLICY ----------
# Reads are allowed by default and taken away by name; writes are denied by
# default and given back by name. The asymmetry is deliberate. "Files my dev
# environment reads" is long, personal and open-ended, so enumerating it
# produces a sandbox that breaks constantly and stops being used; "files that
# are secrets" is short and close to universal. Writes are the opposite:
# almost nothing legitimately writes outside the repo and its caches, so
# enumerating those costs little and catches a lot.
#
# The cost of this shape is that a secret somewhere nobody listed stays
# readable. With the network off by default that is staged exfiltration rather
# than exfiltration, which is the trade being made. See DEVBOX.md.

# Credentials and keys, relative to $HOME.
DENY_READ_HOME = [
    ".ssh", ".gnupg", ".aws", ".azure", ".config/gcloud", ".kube", ".docker",
    ".netrc", ".authinfo", ".authinfo.gpg", ".password-store", ".terraform.d",
    ".npmrc", ".pypirc", ".gem/credentials", ".cargo/credentials.toml",
    ".config/gh", ".config/glab-cli", ".config/op", ".1password",
    ".claude", ".config/anthropic", ".local/share/keyrings",
]

# ~/Library is denied wholesale: it is the highest secret density on the
# machine (Cookies alone are session tokens for everything you are logged in
# to) and the least enumerable. The dev-relevant subtrees are given back
# below -- an allowlist inside a denylist, worth the complication just here.
LIBRARY_ALLOW = [
    "Library/Developer",   # Xcode: toolchains, SDKs, DerivedData
    "Library/Caches",      # Homebrew, pip, go-build, SwiftPM, CocoaPods
    "Library/Fonts",
    "Library/Android",
    "Library/Python",
    "Library/pnpm",
]
# ...except the parts of Caches that are somebody's browsing history.
LIBRARY_REDENY = [
    "Library/Caches/com.apple.Safari",
    "Library/Caches/Google",
    "Library/Caches/Firefox",
    "Library/Caches/BraveSoftware",
]

DENY_READ_ABS = [
    "/Volumes",                 # a mounted Time Machine disk is a copy of $HOME
    "/private/var/db/dslocal",  # local account password hashes
]


def default_write():
    """Scratch space. $TMPDIR is the per-user directory under
    /private/var/folders; the sibling C/ holds per-user caches that
    unsandboxed processes trust, so the tree as a whole is not included.
    /tmp and /var/tmp are world-writable already."""
    tmpdir = os.environ.get("TMPDIR") or "/private/var/folders"
    return [tmpdir, "/private/tmp", "/private/var/tmp"]


# The character devices everything expects to be able to write to. Not
# subpaths, so this is a fixed stanza rather than a rule.
DEVICE_WRITES = '''(allow file-write*
       (literal "/dev/null")
       (literal "/dev/zero")
       (literal "/dev/random")
       (literal "/dev/urandom")
       (literal "/dev/dtracehelper")
       (literal "/dev/tty")
       (literal "/dev/ptmx")
       (subpath "/dev/fd")
       (regex #"^/dev/ttys[0-9]+$"))'''


def vet(path):
    """Resolve and check a rule's path. Raises ResolveError if it names
    something that isn't there: a default naming a tool you haven't installed
    is normal, not an error."""
    r = resolve(path)
    reject_unquotable(r)
    # (subpath "/") as an allow would cancel every deny below it, and as a
    # deny would shut the machine. Neither is ever meant.
    if r == "/":
        die("‘/’ is not a usable rule: name a directory under it.")
    return r


def stanzas(rules, op):
    """Render (action, path) pairs as SBPL, one stanza per run of like
    actions. The order is the meaning: SBPL is last-match-wins, so a later
    rule overrides an earlier one and reordering these changes the policy."""
    out, kind, pending = [], None, []

    def flush():
        if pending:
            body = "\n".join('       (subpath "%s")' % q for q in pending)
            out.append("(%s %s\n%s)" % (kind, op, body))

    for action, path in rules:
        try:
            r = vet(path)
        except ResolveError:
            continue
        if action != kind:
            flush()
            kind, pending = action, []
        pending.append(r)
    flush()
    return "\n".join(out)


def read_ruleset(cwd, opts):
    h = home()
    rules = [("deny", "/Users"), ("allow", h)]   # other users' homes stay shut
    rules += [("deny", p) for p in DENY_READ_ABS]
    rules += [("deny", os.path.join(h, p)) for p in DENY_READ_HOME]
    rules.append(("deny", os.path.join(h, "Library")))
    rules += [("allow", os.path.join(h, p)) for p in LIBRARY_ALLOW]
    rules += [("deny", os.path.join(h, p)) for p in LIBRARY_REDENY]
    # Which paths are protected is itself a hint worth not handing over.
    rules.append(("deny", config_dir()))
    rules += read_config("deny-read", "deny", "allow")
    rules += [("allow", p) for p in opts["extra_read"]]
    # Last, so the repo can always read itself whatever else matched.
    rules.append(("allow", cwd))
    return rules


def write_ruleset(cwd, opts):
    rules = [("allow", cwd)] + [("allow", p) for p in default_write()]
    # Repo-supplied code that can edit these gets to run commands later,
    # outside the sandbox, the next time you touch the repo with git:
    # core.fsmonitor, core.sshCommand and diff.*.textconv all execute.
    rules += [("deny", os.path.join(cwd, ".git/hooks")),
              ("deny", os.path.join(cwd, ".git/config"))]
    # After the .git denies, so naming one of them in the config reverses it.
    rules += read_config("allow-write", "allow", "deny")
    rules += [("allow", p) for p in opts["extra_write"]]
    return rules


PROFILE = '''(version 1)
(allow default)

;; ---- writes: the working directory and scratch space, nothing else ----
(deny file-write*)
{write_rules}
;; The character devices everything expects to be able to write to.
{device_writes}

;; ---- reads: everything, minus what is worth stealing ----
{read_rules}
;; Metadata everywhere regardless, so that stat() and path-walking work.
(allow file-read-metadata)'''

NO_NETWORK = '''

;; ---- network: no IP, unix sockets kept ----
;; Unix-domain sockets are matched by path rather than by address, so allowing
;; the directories they live in keeps local services (syslog, the DNS resolver,
;; pasteboard helpers) working while every IP address stays unreachable.
(deny network*)
(allow network*
       (subpath "/private/var/run")
       (subpath "/private/tmp")
       (subpath "/private/var/folders"))'''


def build_profile(cwd, opts):
    reads = read_ruleset(cwd, opts)
    writes = write_ruleset(cwd, opts)

    # The final (allow file-read* (subpath cwd)) would override any deny the
    # working directory happens to fall under, so refuse rather than quietly
    # undo one: `cd ~/.ssh && devbox` is a mistake, not a request.
    for action, path in reads:
        if action != "deny":
            continue
        try:
            d = vet(path)
        except ResolveError:
            continue
        if cwd == d or cwd.startswith(d + "/"):
            die("refusing to run in ‘%s’: it is inside ‘%s’, "
                "which is on the read denylist." % (cwd, d))

    write_rules = stanzas(writes, "file-write*")
    # A bare `(allow file-write*)` -- what an empty stanza renders as -- would
    # cancel the deny above it and make the whole filesystem writable.
    if "(allow file-write*\n" not in write_rules:
        die("internal error: no writable path; the profile would be unsafe.")

    profile = PROFILE.format(
        write_rules=write_rules,
        device_writes=DEVICE_WRITES,
        read_rules=stanzas(reads, "file-read*"),
    )
    if opts["network"] == "no":
        profile += NO_NETWORK
    return profile


# ---------- RUNNING ----------

def run_with_why(profile, cmd):
    """--why: run rather than exec, so that the denials can be collected
    afterwards. `log show` after the fact rather than `log stream` alongside,
    because stream takes a moment to attach and would miss the denials at
    startup, which are the ones you most want to see."""
    started = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    status = subprocess.call([SANDBOX_EXEC, "-p", profile] + cmd)
    print("%s: sandbox denials since %s:" % (PROG, started), file=sys.stderr)
    # A denial is logged as e.g.
    #   Sandbox: bash(123) deny(1) file-read-data /Users/me/.ssh/id_ed25519
    # The predicate is the part most likely to need adjusting across macOS
    # releases; `log show --last 2m --predicate 'eventMessage CONTAINS "deny("'`
    # by hand is the fallback.
    out = subprocess.run(
        [LOG, "show", "--style", "compact", "--start", started,
         "--predicate", 'eventMessage CONTAINS "deny("'],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
    ).stdout
    lines = [l for l in out.splitlines() if not l.startswith("Timestamp")]
    if lines:
        print("\n".join(lines), file=sys.stderr)
    else:
        print("%s: none logged." % PROG, file=sys.stderr)
    return status


def main():
    # ---------- PLATFORM ----------
    # sandbox-exec is macOS-only.
    if os.uname().sysname != "Darwin":
        die("macOS only -- sandbox-exec doesn't exist on %s." % os.uname().sysname)
    if not os.access(SANDBOX_EXEC, os.X_OK):
        die("%s is missing; nothing to sandbox with." % SANDBOX_EXEC)

    cwd = os.getcwd()
    opts, rest = parse_args(sys.argv[1:])

    if opts["network"] not in ("yes", "no"):
        die("--network takes ‘yes’ or ‘no’, not ‘%s’."
            % opts["network"])

    check_allow("--allow-read", opts["extra_read"])
    check_allow("--allow-write", opts["extra_write"])

    cmd = rest if rest else [os.environ.get("SHELL") or "/bin/bash"]

    # ---------- WORKING DIRECTORY MUST BE REASONABLE ----------
    # The whole point is that one directory is writable, so a home directory or
    # the root of the filesystem is not a useful choice: mount a project.
    parts = cwd.split("/")  # "/Users/me/x" -> ['', 'Users', 'me', 'x']
    inside_a_home = len(parts) > 3 and parts[1] == "Users"
    if not inside_a_home and (cwd == "/" or cwd == "/Users" or cwd.startswith("/Users/")):
        die("refusing to run with ‘%s’ writable: cd to a project "
            "directory, not a home directory or the root of the filesystem." % cwd)
    reject_unquotable(cwd)

    profile = build_profile(cwd, opts)

    if opts["print_profile"]:
        print(profile)
        return 0

    # Marks the shell as sandboxed for anyone who wants to say so in a prompt.
    os.environ["DEVBOX"] = "1"

    if sys.stderr.isatty():
        print("%s: ‘%s’ writable, network %s, credentials unreadable."
              % (PROG, cwd, opts["network"]), file=sys.stderr)

    if not opts["why"]:
        os.execv(SANDBOX_EXEC, [SANDBOX_EXEC, "-p", profile] + cmd)
    return run_with_why(profile, cmd)


if __name__ == "__main__":
    sys.exit(main())
