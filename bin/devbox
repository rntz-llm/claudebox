#!/usr/bin/python3 -I
"""Run a command against the current directory under a macOS sandbox, so that
repo-supplied code -- git hooks, build scripts, dependencies -- can't write
outside the repo, read anything outside a fixed allowlist, or talk to the
network. See DEVBOX.md.

The shebang is deliberate. `-I` (isolated) ignores PYTHONPATH/PYTHONHOME, drops
the user site directory, and keeps this script's own directory off sys.path;
the absolute interpreter path means an activated .venv or a pyenv shim -- both
of which are chosen by the directory you are standing in, which is the
directory you have decided not to trust -- cannot supply the interpreter that
decides what the sandbox means.
"""

import os
import shutil
import subprocess
import sys
from datetime import datetime

PROG = os.path.basename(sys.argv[0])
SANDBOX_EXEC = "/usr/bin/sandbox-exec"
LOG = "/usr/bin/log"

USAGE = """\
usage: {prog} [options] [--] [command [args...]]

Runs command (default: $SHELL) under a sandbox profile that allows writes only
to the current directory and to temporary directories, allows reads only of the
system, the toolchain and the current directory, and by default denies IP
network access.

options:
  --network=yes|no        allow IP networking (default: no)
  --allow-read PATH       also permit reads under PATH (repeatable)
  --allow-write PATH      also permit writes under PATH (repeatable; also
                          permits reads, since a write-only path is useless)
  --why                   report the sandbox denials the command caused, after
                          it exits. This is how you find out what to add.
  --unsafe-read-anything  cancel the read allowlist entirely. An escape hatch
                          for when something won't run and you need it to now,
                          not a mode to live in; writes and network are
                          unaffected.
  --print-profile         print the generated sandbox profile and exit
  -h, --help              this

Option parsing stops at the first non-option argument, so flags meant for the
command need no --:  {prog} cargo test --release
"""


def die(msg):
    print("%s: %s" % (PROG, msg), file=sys.stderr)
    sys.exit(1)


class ResolveError(Exception):
    """A path that can't be turned into an absolute physical path. Fatal when
    the user named it explicitly, ignorable when it came from a default list."""


# ---------- PATHS ----------

def _split(p):
    """POSIX dirname/basename, which differ from os.path for trailing slashes
    and for bare names."""
    stripped = p.rstrip("/")
    if not stripped:
        return "/", "/"
    head, _, base = stripped.rpartition("/")
    if not head:
        head = "/" if p.startswith("/") else "."
    return head, base


def resolve(p):
    """Absolute physical path. Does not error if the file does not exist yet,
    but resolves its directory path fully.

    It's important that we fully resolve things because sandbox-exec/macOS
    Seatbelt matches the resolved physical path, so otherwise denying reads of
    a symlinked file wouldn't deny reads of that file.
    """
    original = p
    # A literal tilde, from a quoted argument the shell didn't expand.
    if p == "~":
        p = home()
    elif p.startswith("~/"):
        p = os.path.join(home(), p[2:])

    links = 0
    while os.path.islink(p):
        links += 1
        if links > 40:
            raise ResolveError(
                "‘%s’ is more than 40 symlinks deep; a loop?" % original)
        target = os.readlink(p)
        p = target if target.startswith("/") else os.path.join(_split(p)[0], target)

    if os.path.isdir(p):
        return os.path.realpath(p)

    head, base = _split(p)
    if not os.path.isdir(head):
        raise ResolveError("no such directory: %s" % head)
    head = os.path.realpath(head)
    return "/" + base if head == "/" else head + "/" + base


def reject_unquotable(p):
    """Profile paths are interpolated into a double-quoted SBPL string, and
    SBPL has no way to express a literal quote or backslash inside one."""
    if '"' in p or "\\" in p or "\n" in p:
        die("refusing path with a quote, backslash or newline: %s" % p)


def home():
    h = os.environ.get("HOME")
    if not h:
        die("HOME is not set.")
    return h


# ---------- ARGUMENTS ----------

def parse_args(argv):
    """Hand-rolled rather than argparse, which cannot express "stop at the
    first non-option argument" -- the property that lets you write
    `devbox cargo test --release` with no `--`. REMAINDER is buggy when the
    remainder starts with something option-shaped, and parse_known_args
    scatters the command's own flags into the unrecognised pile."""
    opts = {
        "network": "no",
        "extra_read": [],
        "extra_write": [],
        "print_profile": False,
        "read_anything": False,
        "why": False,
    }

    def value(i):
        """`--flag VALUE`; a trailing `--flag` with nothing after it yields the
        empty string, which the checks below turn into an error."""
        return (argv[i + 1], 2) if i + 1 < len(argv) else ("", 1)

    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--network":
            opts["network"], step = value(i)
        elif a.startswith("--network="):
            opts["network"], step = a[len("--network="):], 1
        elif a == "--allow-read":
            v, step = value(i)
            opts["extra_read"].append(v)
        elif a.startswith("--allow-read="):
            opts["extra_read"].append(a[len("--allow-read="):])
            step = 1
        elif a == "--allow-write":
            v, step = value(i)
            opts["extra_write"].append(v)
        elif a.startswith("--allow-write="):
            opts["extra_write"].append(a[len("--allow-write="):])
            step = 1
        elif a == "--unsafe-read-anything":
            opts["read_anything"], step = True, 1
        elif a == "--why":
            opts["why"], step = True, 1
        elif a == "--print-profile":
            opts["print_profile"], step = True, 1
        elif a in ("-h", "--help"):
            sys.stdout.write(USAGE.format(prog=PROG))
            sys.exit(0)
        elif a == "--":
            i += 1
            break
        elif a.startswith("-"):
            die("unknown option ‘%s’ (see --help)." % a)
        else:
            break
        i += step

    return opts, argv[i:]


def check_allow(flag, paths):
    """Vet the paths you asked for up front. An unresolvable allowlist entry
    would otherwise be dropped and reappear later as a mysterious denial."""
    for p in paths:
        if not p:
            die("%s needs a path." % flag)
        try:
            resolve(p)
        except ResolveError as e:
            die(e)


# ---------- WHAT THE SANDBOX ALLOWS ----------

# Read access to the system itself. Deliberately broad: these are the most
# stable paths in macOS, they're world-readable anyway, and narrowing them is
# how a sandbox turns into something you stop using. Note what is *not* here:
# /Volumes (a mounted Time Machine disk is a copy of your home directory),
# /Users (see DEFAULT_READ), and /private/var/folders beyond the scratch
# directories below.
SYSTEM_READ = [
    "/bin",
    "/sbin",
    "/usr",
    "/System",
    "/Library",
    "/Applications",
    "/opt",
    "/private/etc",
    "/private/var/db",  # zoneinfo, among other things; the rest is root-owned
    "/private/var/run",
    "/dev",
]

# Scratch space. $TMPDIR is a per-user directory under /private/var/folders,
# which also holds per-user caches; /tmp and /var/tmp are world-writable
# already, so permitting them concedes nothing that a process running as you
# couldn't already do.
DEFAULT_WRITE = [
    "/private/var/folders",
    "/private/tmp",
    "/private/var/tmp",
]


def default_read(cmd):
    """Toolchain configuration that dev tools need in order to work at all.
    Cargo's and npm's shared caches are deliberately *not* writable -- see
    DEVBOX.md."""
    paths = [
        os.path.join(home(), ".gitconfig"),
        os.path.join(home(), ".gitexclude"),
        os.path.join(home(), ".config/git"),
        os.path.join(home(), ".rustup"),
        os.path.join(home(), ".cargo"),
    ]
    # To run a command you have to be able to read it. This matters for tools
    # installed under $HOME, like ~/.local/bin/claude, but also for anything
    # outside the system prefixes above. The containing directory, not just the
    # binary, because wrappers commonly exec a sibling.
    cmd_path = shutil.which(cmd[0])
    if cmd_path and cmd_path.startswith("/"):
        paths.append(_split(cmd_path)[0])
    return paths


def filters(paths):
    """One SBPL filter line per path, resolved and vetted. subpath matches the
    path itself as well as anything under it, so it covers plain files too."""
    lines = []
    for p in paths:
        # A path that doesn't exist is not an error here: allowlists name
        # things like caches that a tool may create later, and permitting a
        # path that never appears costs nothing.
        try:
            r = resolve(p)
        except ResolveError:
            continue
        reject_unquotable(r)
        # (subpath "/") would silently cancel the entire allowlist.
        if r == "/":
            die("‘/’ as an allowlist entry would permit everything; "
                "use --unsafe-read-anything if that is what you mean.")
        lines.append('       (subpath "%s")' % r)
    return "\n".join(lines)


# ---------- THE PROFILE ----------
# SBPL is last-match-wins, so every deny below is followed by the allows that
# carve holes in it; reordering them silently changes the meaning.
#
# The base is (allow default), and the three things that matter for the threat
# model are taken away. That is not the same as (deny default), which would
# additionally close operation classes -- process-exec, mach-lookup, sysctl,
# iokit, pseudo-tty -- that ordinary dev tooling needs and that would have to
# be enumerated and re-enumerated against an undocumented, version-specific
# list. Files and network are denied by default *within* an allow-default base,
# which is where the security is; see DEVBOX.md.

PROFILE = '''(version 1)
(allow default)

;; ---- writes: the working directory and scratch space, nothing else ----
(deny file-write*)
(allow file-write*
{write_filters})
;; The character devices everything expects to be able to write to.
(allow file-write*
       (literal "/dev/null")
       (literal "/dev/zero")
       (literal "/dev/random")
       (literal "/dev/urandom")
       (literal "/dev/dtracehelper")
       (literal "/dev/tty")
       (subpath "/dev/fd")
       (regex #"^/dev/ttys[0-9]+"))

;; ---- reads: nothing, then an allowlist ----
;; Denied everywhere rather than just under /Users, so that a path nobody
;; thought to enumerate -- a Time Machine volume under /Volumes, the
;; /System/Volumes/Data spelling of your home directory, a checkout under /opt
;; -- is closed by default instead of open by default.
(deny file-read*)
;; Metadata only, everywhere, so that stat() and path-walking work while
;; contents stay unreadable.
(allow file-read-metadata)
;; The root directory itself, so that readdir("/") works.
(allow file-read* (literal "/"))
(allow file-read*
{read_filters})'''

READ_ANYTHING = '''

;; ---- --unsafe-read-anything: the allowlist above is cancelled ----
(allow file-read*)'''

NO_NETWORK = '''

;; ---- network: no IP, unix sockets kept ----
;; Unix-domain sockets are matched by path rather than by address, so allowing
;; the directories they live in keeps local services (syslog, the DNS resolver,
;; pasteboard helpers) working while every IP address stays unreachable.
(deny network*)
(allow network*
       (subpath "/private/var/run")
       (subpath "/private/tmp")
       (subpath "/private/var/folders"))'''


def build_profile(cwd, cmd, opts):
    # Everything writable is also readable: a write-only directory is not a
    # useful thing to hand a compiler, and under a global read deny you have to
    # say so.
    write_paths = [cwd] + DEFAULT_WRITE + opts["extra_write"]
    read_paths = SYSTEM_READ + default_read(cmd) + write_paths + opts["extra_read"]

    read_filters = filters(read_paths)
    write_filters = filters(write_paths)

    # An empty filter list renders as a bare `(allow file-read*)`, which
    # cancels the deny above it and allows everything. Both lists contain the
    # working directory, so this can't happen today -- but the failure is
    # silent and total, so assert it.
    if not read_filters or not write_filters:
        die("internal error: empty allowlist would permit everything.")

    profile = PROFILE.format(read_filters=read_filters, write_filters=write_filters)
    if opts["read_anything"]:
        profile += READ_ANYTHING
    if opts["network"] == "no":
        profile += NO_NETWORK
    return profile


# ---------- RUNNING ----------

def run_with_why(profile, cmd):
    """--why: run rather than exec, so that the denials can be collected
    afterwards. `log show` after the fact rather than `log stream` alongside,
    because stream takes a moment to attach and would miss the denials at
    startup, which are the ones you most want to see."""
    started = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    status = subprocess.call([SANDBOX_EXEC, "-p", profile] + cmd)
    print("%s: sandbox denials since %s:" % (PROG, started), file=sys.stderr)
    # A denial is logged as e.g.
    #   Sandbox: bash(123) deny(1) file-read-data /Users/me/.ssh/id_ed25519
    # The predicate is the part most likely to need adjusting across macOS
    # releases; `log show --last 2m --predicate 'eventMessage CONTAINS "deny("'`
    # by hand is the fallback.
    out = subprocess.run(
        [LOG, "show", "--style", "compact", "--start", started,
         "--predicate", 'eventMessage CONTAINS "deny("'],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
    ).stdout
    lines = [l for l in out.splitlines() if not l.startswith("Timestamp")]
    if lines:
        print("\n".join(lines), file=sys.stderr)
    else:
        print("%s: none logged." % PROG, file=sys.stderr)
    return status


def main():
    # ---------- PLATFORM ----------
    # sandbox-exec is macOS-only.
    if os.uname().sysname != "Darwin":
        die("macOS only -- sandbox-exec doesn't exist on %s." % os.uname().sysname)
    if not os.access(SANDBOX_EXEC, os.X_OK):
        die("%s is missing; nothing to sandbox with." % SANDBOX_EXEC)

    cwd = os.getcwd()
    opts, rest = parse_args(sys.argv[1:])

    if opts["network"] not in ("yes", "no"):
        die("--network takes ‘yes’ or ‘no’, not ‘%s’."
            % opts["network"])

    check_allow("--allow-read", opts["extra_read"])
    check_allow("--allow-write", opts["extra_write"])

    cmd = rest if rest else [os.environ.get("SHELL") or "/bin/bash"]

    # ---------- WORKING DIRECTORY MUST BE REASONABLE ----------
    # The whole point is that one directory is writable, so a home directory or
    # the root of the filesystem is not a useful choice: mount a project.
    parts = cwd.split("/")  # "/Users/me/x" -> ['', 'Users', 'me', 'x']
    inside_a_home = len(parts) > 3 and parts[1] == "Users"
    if not inside_a_home and (cwd == "/" or cwd == "/Users" or cwd.startswith("/Users/")):
        die("refusing to run with ‘%s’ writable: cd to a project "
            "directory, not a home directory or the root of the filesystem." % cwd)
    reject_unquotable(cwd)

    profile = build_profile(cwd, cmd, opts)

    if opts["print_profile"]:
        print(profile)
        return 0

    # Marks the shell as sandboxed for anyone who wants to say so in a prompt.
    os.environ["DEVBOX"] = "1"

    if sys.stderr.isatty():
        print("%s: ‘%s’ writable, network %s, reads outside the "
              "allowlist denied." % (PROG, cwd, opts["network"]), file=sys.stderr)
    if opts["read_anything"]:
        print("%s: --unsafe-read-anything: every readable file on the machine "
              "is readable in here." % PROG, file=sys.stderr)

    if not opts["why"]:
        os.execv(SANDBOX_EXEC, [SANDBOX_EXEC, "-p", profile] + cmd)
    return run_with_why(profile, cmd)


if __name__ == "__main__":
    sys.exit(main())
