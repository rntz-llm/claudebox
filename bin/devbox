#!/usr/bin/python3 -I
"""Run a command against the current directory under a macOS sandbox, so that
repo-supplied code -- git hooks, build scripts, dependencies -- can't write
outside the repo, read your credentials, or talk to the network. See DEVBOX.md.

The shebang is deliberate. `-I` (isolated) ignores PYTHONPATH/PYTHONHOME, drops
the user site directory, and keeps this script's own directory off sys.path;
the absolute interpreter path means an activated .venv or a pyenv shim -- both
of which are chosen by the directory you are standing in, which is the
directory you have decided not to trust -- cannot supply the interpreter that
decides what the sandbox means.
"""

import errno
import itertools
import os
import subprocess
import sys
from dataclasses import dataclass, field
from datetime import datetime
from typing import NoReturn

# A policy directive: action is "allow" or "deny", op is "read" or "write".
# Order is the meaning -- SBPL is last-match-wins -- so these travel as one
# ordered stream and are split by op only at the moment of rendering.
Directive = tuple[str, str, str]  # (action, op, path)
Rule = tuple[str, str]            # (action, path), within a single op

PROG = os.path.basename(sys.argv[0])

def die(msg) -> NoReturn:
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(1)

def home() -> str:
    h = os.environ.get("HOME")
    if not h: die("HOME is not set.")
    return h

SANDBOX_EXEC = "/usr/bin/sandbox-exec"
LOG = "/usr/bin/log"
XDG_CONFIG_DIR = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home(), ".config")
CONFIG_DIR = os.path.join(XDG_CONFIG_DIR, "devbox")
CONFIG_FILE = os.path.join(CONFIG_DIR, "rules")

USAGE = """\
usage: {prog} [options] [--] [command [args...]]

Runs command (default: $SHELL) under a sandbox profile that allows writes only
to the current directory and to temporary directories, denies reads to some
sensitive directories, and by default denies network access.

options:
  --network=yes|no     allow IP networking (default: no)
  --allow-read PATH    permit reads under PATH, overriding a deny
  --deny-read PATH     deny reads under PATH
  --allow-write PATH   permit writes under PATH
  --deny-write PATH    deny writes under PATH, overriding an allow
  --why                report the sandbox denials the command caused, after it
                       exits. This is how you find out what to add.
  --print-profile      print the generated sandbox profile and exit
  -h, --help           this

The --allow/--deny options are repeatable and apply in the order you give
them, across reads and writes alike; the last one matching a path wins.
--allow-write also permits reads, and --deny-read also forbids writes, so a
path is never writable without being readable.

The same directives can be listed one per line, '#' for a comment, in
  {config_file}

Precedence, lowest first: the built-in defaults, then that file, then the
command line.

Option parsing stops at the first non-option argument, so flags meant for the
command need no --:  {prog} cargo test --release
""".format(
    prog=PROG,
    config_file=CONFIG_FILE,
)


# -------------------- PATHS --------------------
def resolve(p: str) -> str:
    """Absolute physical path, with every symlink resolved, because Seatbelt
    matches the path an operation resolves to rather than the one it was handed.

    Raises OSError if the path is *broken* -- a symlink loop, a parent we can't
    traverse. This is fatal: silently dropping rules is a security problem. By
    contrast, absence is not an error: rules apply even to files that don't
    exist or don't yet exist.
    """
    # realpath() resolves as far as the path exists and re-attaches the rest,
    # but won't say *why* it couldn't finish, so os.stat() is asked first and
    # its errno does the classifying.
    p = os.path.expanduser(p)
    try:
        os.stat(p)
    except OSError as e:
        if e.errno not in (errno.ENOENT, errno.ENOTDIR):
            # ELOOP, or a parent we aren't allowed to traverse. Either way the
            # path is not what it claims to be, and guessing would be worse.
            raise
    return os.path.realpath(p)

def vet(path: str) -> str:
    """Resolve a rule's path and check it can be written into the profile."""
    p = resolve(path)
    # Paths are interpolated into a double-quoted SBPL string, and SBPL cannot
    # express a literal quote or backslash inside one.
    if '"' in p or "\\" in p or "\n" in p:
        die(f"refusing path with a quote, backslash or newline: {p}")
    # (subpath "/") as an allow would cancel every deny below it, and as a deny
    # would shut the machine. Neither is ever meant.
    if p == "/":
        die("‘/’ is not a usable rule: name a directory under it.")
    return p


# -------------------- ARGUMENTS --------------------

@dataclass
class Options:
    network: str = "no"
    # One ordered list, not one per op, so that every --allow/--deny keeps its
    # position relative to all the others: `--allow-write X --deny-read X` and
    # the reverse mean different things.
    directives: list[Directive] = field(default_factory=list)
    print_profile: bool = False
    why: bool = False

VALUE_FLAGS = ("--network", "--allow-read", "--deny-read",
               "--allow-write", "--deny-write")

def parse_args(argv: list[str]) -> tuple[Options, list[str]]:
    """Hand-rolled rather than argparse, which cannot express "stop at the
    first non-option argument" -- the property that lets you write
    `devbox cargo test --release` with no `--`. REMAINDER misbehaves when the
    remainder starts with something option-shaped, and parse_known_args
    scatters the command's own flags into the unrecognised pile."""
    opts = Options()
    i = 0
    while i < len(argv):
        arg, step = argv[i], 1
        name, eq, inline = arg.partition("=")
        if name in VALUE_FLAGS:
            # Both `--flag=VALUE` and `--flag VALUE`. A trailing `--flag` with
            # nothing after it yields "", which the checks below reject.
            if eq:
                value = inline
            else:
                value, step = (argv[i + 1] if i + 1 < len(argv) else ""), 2
            if name == "--network":
                opts.network = value
            else:
                action, _, op = name[2:].partition("-")  # --allow-read
                opts.directives.append((action, op, value))
        elif arg == "--why":
            opts.why = True
        elif arg == "--print-profile":
            opts.print_profile = True
        elif arg in ("-h", "--help"):
            sys.stdout.write(USAGE)
            sys.exit(0)
        elif arg == "--":
            i += 1
            break
        elif arg.startswith("-"):
            die(f"unknown option ‘{arg}’ (see --help).")
        else:
            break
        i += step
    return opts, argv[i:]

def check_flag_rules(directives: list[Directive]) -> None:
    """Vet the paths you asked for up front. An unresolvable one would
    otherwise be dropped and reappear later as a mysterious denial. Stricter
    than the config files, which may name tools you haven't installed: a path
    you just typed should exist, or at least its parent should."""
    for action, op, p in directives:
        flag = f"--{action}-{op}"
        if not p:
            die(f"{flag} needs a path.")
        try:
            resolve(p)
        except OSError as e:
            die(f"{e.filename}: {e.strerror} (from {flag})")
        # A path you just typed should at least have a parent that exists. The
        # defaults and the config files are exempt -- they may name tools you
        # don't have -- but here a typo would allow or deny the wrong thing,
        # silently, and one stat catches it.
        head = os.path.dirname(os.path.expanduser(p).rstrip("/")) or "."
        if not os.path.isdir(head):
            die(f"no such directory: {head} (from {flag})")

DIRECTIVES = ("allow-read", "deny-read", "allow-write", "deny-write")

def read_config() -> list[Directive]:
    """`DIRECTIVE PATH` per line, in file order, where DIRECTIVE is one of the
    four --allow/--deny flag names. Blank lines and lines starting with '#'
    are ignored; a missing file is not an error.

    Only whole-line comments: a '#' is legal in a path, and silently
    truncating someone's rule at one would be the wrong kind of surprise."""
    try:
        with open(CONFIG_FILE) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return []
    except OSError as e:
        die(f"cannot read {CONFIG_FILE}: {e}")
    directives = []
    for n, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        word, _, path = line.partition(" ")
        if word not in DIRECTIVES:
            die(f"{CONFIG_FILE}:{n}: expected one of "
                f"{', '.join(DIRECTIVES)}, got ‘{word}’")
        if not path.strip():
            die(f"{CONFIG_FILE}:{n}: {word} needs a path")
        action, _, op = word.partition("-")
        directives.append((action, op, path.strip()))
    return directives


# -------------------- POLICY --------------------
# Reads are allowed by default and taken away by name; writes are denied by
# default and given back by name. The asymmetry is deliberate. "Files my dev
# environment reads" is long, personal and open-ended, so enumerating it
# produces a sandbox that breaks constantly and stops being used; "files that
# are secrets" is short and close to universal. Writes are the opposite: almost
# nothing legitimately writes outside the repo and its caches, so enumerating
# those costs little and catches a lot.
#
# The cost of this shape is that a secret somewhere nobody listed stays
# readable. With the network off by default that is staged exfiltration rather
# than exfiltration, which is the trade being made. See DEVBOX.md.

# Credentials and keys, relative to $HOME.
DENY_READ_HOME = [
    ".ssh", ".gnupg", ".aws", ".azure", ".config/gcloud", ".kube", ".docker",
    ".netrc", ".authinfo", ".authinfo.gpg", ".password-store", ".terraform.d",
    ".npmrc", ".pypirc", ".gem/credentials", ".cargo/credentials.toml",
    ".config/gh", ".config/glab-cli", ".config/op", ".1password",
    ".claude", ".config/anthropic", ".local/share/keyrings",
]

# ~/Library is denied wholesale: it is the highest secret density on the
# machine (Cookies alone are session tokens for everything you are logged in
# to) and the least enumerable. The dev-relevant subtrees are given back here
# -- an allowlist inside a denylist, worth the complication just this once.
LIBRARY_ALLOW = [
    "Library/Developer",   # Xcode: toolchains, SDKs, DerivedData
    "Library/Caches",      # Homebrew, pip, go-build, SwiftPM, CocoaPods
    "Library/Fonts",
    "Library/Android",
    "Library/Python",
    "Library/pnpm",
]

# ...except the parts of Caches that are somebody's browsing history.
LIBRARY_REDENY = [
    "Library/Caches/com.apple.Safari",
    "Library/Caches/Google",
    "Library/Caches/Firefox",
    "Library/Caches/BraveSoftware",
]

DENY_READ_ABS = [
    "/Volumes",                 # a mounted Time Machine disk is a copy of $HOME
    "/private/var/db/dslocal",  # local account password hashes
]

# The character devices everything expects to be able to write to. Not
# subpaths, so this is a fixed stanza rather than a rule.
DEVICE_WRITES = '''(allow file-write*
       (literal "/dev/null")
       (literal "/dev/zero")
       (literal "/dev/random")
       (literal "/dev/urandom")
       (literal "/dev/dtracehelper")
       (literal "/dev/tty")
       (literal "/dev/ptmx")
       (subpath "/dev/fd")
       (regex #"^/dev/ttys[0-9]+$"))'''

def scratch_dirs() -> list[str]:
    """$TMPDIR is the per-user directory under /private/var/folders; the
    sibling C/ holds per-user caches that unsandboxed processes trust, so the
    tree as a whole is not included. /tmp and /var/tmp are world-writable
    already."""
    tmpdir = os.environ.get("TMPDIR") or "/private/var/folders"
    return [tmpdir, "/private/tmp", "/private/var/tmp"]

def expand(d: Directive) -> list[Directive]:
    """A directive and whatever it implies, at the same position.

    Writable-but-not-readable is not a state worth being able to express: it
    breaks every tool that opens O_RDWR, and it doesn't even buy secrecy,
    because `mv ~/.aws/creds ./stolen` needs write on both ends and read on
    neither. So allow-write carries allow-read, and -- its contrapositive --
    deny-read carries deny-write. Together they keep `writable implies
    readable` true at every point in the stream. The other two directives
    imply nothing: .git/config must stay readable while being unwritable."""
    action, op, path = d
    if (action, op) == ("allow", "write"):
        return [d, ("allow", "read", path)]
    if (action, op) == ("deny", "read"):
        return [d, ("deny", "write", path)]
    return [d]

def default_directives(cwd: str) -> list[Directive]:
    """The built-in policy, lowest precedence.

    The working directory is allowed early, ahead of the credential denies,
    so that those override it: `cd ~/.ssh && devbox` leaves ~/.ssh shut
    rather than quietly reopening it."""
    h = home()
    ds: list[Directive] = [("deny", "read", "/Users"),   # other homes stay shut
                           ("allow", "read", h),
                           ("allow", "write", cwd)]
    ds += [("allow", "write", p) for p in scratch_dirs()]
    ds += [("deny", "read", p) for p in DENY_READ_ABS]
    ds += [("deny", "read", os.path.join(h, p)) for p in DENY_READ_HOME]
    ds += [("deny", "read", os.path.join(h, "Library"))]
    ds += [("allow", "read", os.path.join(h, p)) for p in LIBRARY_ALLOW]
    ds += [("deny", "read", os.path.join(h, p)) for p in LIBRARY_REDENY]
    # Which paths are protected is itself a hint worth not handing over.
    ds += [("deny", "read", CONFIG_DIR)]
    # Repo-supplied code that can edit these gets to run commands later,
    # outside the sandbox, the next time you touch the repo with git:
    # core.fsmonitor, core.sshCommand and diff.*.textconv all execute. Denying
    # the write only: git has to be able to read its own config.
    ds += [("deny", "write", os.path.join(cwd, ".git/hooks")),
           ("deny", "write", os.path.join(cwd, ".git/config"))]
    return ds

def ruleset(cwd: str, opts: Options) -> list[Directive]:
    """The whole policy as one ordered stream: defaults, then your config
    file, then your command line, each able to override what came before."""
    ds = default_directives(cwd) + read_config() + opts.directives
    return [e for d in ds for e in expand(d)]

def rules_for(op: str, directives: list[Directive]) -> list[Rule]:
    return [(action, path) for action, o, path in directives if o == op]

def stanzas(rules: list[Rule], op: str) -> str:
    """Render rules as SBPL, one stanza per run of like actions. The order is
    the meaning: SBPL is last-match-wins, so a later rule overrides an earlier
    one and reordering these changes the policy."""
    resolved = []
    for action, path in rules:
        try:
            # Every rule either renders or is fatal. A path that doesn't
            # exist yet still gets a rule, so nothing is silently dropped.
            resolved.append((action, vet(path)))
        except OSError as e:
            die(f"{e.filename}: {e.strerror} ({action} rule)")
    out = []
    for action, group in itertools.groupby(resolved, key=lambda r: r[0]):
        body = "\n".join(f'       (subpath "{p}")' for _, p in group)
        out.append(f"({action} {op}\n{body})")
    return "\n".join(out)

def refuse_denied_cwd(cwd: str) -> None:
    """A working directory the defaults deny reads of yields a sandbox where
    nothing works, since the repo can neither be read nor -- deny-read
    implying deny-write -- written. That is safe but baffling, so say why.
    Advisory only: the profile would be correct either way.

    Only the defaults are policed; denying your own repo from the config file
    or the command line is a thing you are allowed to mean.

    Last match wins, exactly as SBPL resolves it. Scanning for any matching
    deny is wrong: every path under $HOME matches the `/Users` deny that the
    `$HOME` allow immediately overrides."""
    verdict = None
    defaults = [e for d in default_directives(cwd) for e in expand(d)]
    for action, path in rules_for("read", defaults):
        try:
            d = vet(path)
        except OSError:
            continue  # stanzas() will report it properly in a moment
        if cwd == d or cwd.startswith(d + "/"):
            verdict = (action, d)
    if verdict and verdict[0] == "deny":
        die(f"refusing to run in ‘{cwd}’: it is inside ‘{verdict[1]}’, which "
            "is on the read denylist, so nothing there would be readable.")


PROFILE = '''(version 1)
(allow default)

;; ---- writes: the working directory and scratch space, nothing else ----
(deny file-write*)
;; The character devices everything expects to be able to write to. First, so
;; that a later rule of yours could take one away; nothing in the defaults
;; matches /dev, so nothing does.
{device_writes}
{write_rules}

;; ---- reads: everything, minus what is worth stealing ----
{read_rules}
;; Metadata everywhere regardless, so that stat() and path-walking work.
(allow file-read-metadata)'''

NO_NETWORK = '''

;; ---- network: no IP, unix sockets kept ----
;; Unix-domain sockets are matched by path rather than by address, so allowing
;; the directories they live in keeps local services (syslog, the DNS resolver,
;; pasteboard helpers) working while every IP address stays unreachable.
(deny network*)
(allow network*
       (subpath "/private/var/run")
       (subpath "/private/tmp")
       (subpath "/private/var/folders"))'''

def build_profile(cwd: str, opts: Options) -> str:
    refuse_denied_cwd(cwd)
    directives  = ruleset(cwd, opts)
    read_rules  = stanzas(rules_for("read", directives), "file-read*")
    write_rules = stanzas(rules_for("write", directives), "file-write*")
    # A bare `(allow file-write*)` -- what an empty stanza renders as -- would
    # cancel the deny above it and make the whole filesystem writable.
    if "(allow file-write*\n" not in write_rules:
        die("internal error: no writable path; the profile would be unsafe.")
    profile = PROFILE.format(write_rules=write_rules,
                             read_rules=read_rules,
                             device_writes=DEVICE_WRITES)
    return profile + NO_NETWORK if opts.network == "no" else profile


# -------------------- RUNNING --------------------

def run_with_why(profile: str, cmd: list[str]) -> int:
    """--why: run rather than exec, so that the denials can be collected
    afterwards. `log show` after the fact rather than `log stream` alongside,
    because stream takes a moment to attach and would miss the denials at
    startup, which are the ones you most want to see."""
    started = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    status = subprocess.call([SANDBOX_EXEC, "-p", profile] + cmd)
    print(f"{PROG}: sandbox denials since {started}:", file=sys.stderr)
    # A denial is logged as e.g.
    #   Sandbox: bash(123) deny(1) file-read-data /Users/me/.ssh/id_ed25519
    # The predicate is the part most likely to need adjusting across macOS
    # releases; `log show --last 2m --predicate 'eventMessage CONTAINS "deny("'`
    # by hand is the fallback.
    out = subprocess.run(
        [LOG, "show", "--style", "compact", "--start", started,
         "--predicate", 'eventMessage CONTAINS "deny("'],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
    ).stdout
    denials = [line for line in out.splitlines()
               if not line.startswith("Timestamp")]
    print("\n".join(denials) if denials else f"{PROG}: none logged.",
          file=sys.stderr)
    return status

def refuse_unreasonable_cwd(cwd: str) -> None:
    """The whole point is that one directory is writable, so a home directory
    or the root of the filesystem is not a useful choice: cd to a project."""
    under_users = cwd == "/Users" or cwd.startswith("/Users/")
    # "/Users/me/project" has three slashes; "/Users/me" and "/Users" fewer.
    if cwd == "/" or (under_users and cwd.rstrip("/").count("/") < 3):
        die(f"refusing to run with ‘{cwd}’ writable: cd to a project "
            "directory, not a home directory or the root of the filesystem.")

def main() -> int:
    # sandbox-exec is macOS-only.
    if os.uname().sysname != "Darwin":
        die(f"macOS only -- sandbox-exec doesn't exist on {os.uname().sysname}.")
    if not os.access(SANDBOX_EXEC, os.X_OK):
        die(f"{SANDBOX_EXEC} is missing; nothing to sandbox with.")

    cwd = os.getcwd()
    opts, rest = parse_args(sys.argv[1:])
    if opts.network not in ("yes", "no"):
        die(f"--network takes ‘yes’ or ‘no’, not ‘{opts.network}’.")
    check_flag_rules(opts.directives)
    cmd = rest or [os.environ.get("SHELL") or "/bin/bash"]

    refuse_unreasonable_cwd(cwd)
    vet(cwd)  # the profile will quote it; fail now if it can't be quoted
    profile = build_profile(cwd, opts)

    if opts.print_profile:
        print(profile)
        return 0

    # Marks the shell as sandboxed for anyone who wants to say so in a prompt.
    os.environ["DEVBOX"] = "1"
    if sys.stderr.isatty():
        print(f"{PROG}: ‘{cwd}’ writable, network {opts.network}, "
              "credentials unreadable.", file=sys.stderr)

    if not opts.why:
        os.execv(SANDBOX_EXEC, [SANDBOX_EXEC, "-p", profile] + cmd)
    return run_with_why(profile, cmd)

if __name__ == "__main__":
    sys.exit(main())
