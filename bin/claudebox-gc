#!/bin/bash

set -euo pipefail

# Lists claudebox's per-project Claude state, then offers to delete or re-key
# the state of each project whose directory no longer exists.

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/claudebox/projects"

# Must match claudebox.
state_key() {
    printf '%s-%s' "$(basename "$1")" "$(printf %s "$1" | shasum -a 256 | cut -c1-12)"
}

if [[ ! -d "$state_root" ]]; then
    echo "No claudebox state in ‘${state_root}’."
    exit 0
fi

orphans=()
printf '%6s  %-10s  %s\n' SIZE LAST-USED PROJECT
for dir in "$state_root"/*/; do
    dir="${dir%/}"
    # if there are no subdirs, the * won't expand and we'll hit this case
    [[ -d "$dir" ]] || continue
    size="$(du -sh "$dir" | cut -f1)"
    if [[ -f "$dir/path" ]]; then
        path="$(cat "$dir/path")"
        used="$(date -r "$dir/path" +%Y-%m-%d)"
        if [[ ! -d "$path" ]]; then
            orphans+=("$dir")
            path="$path (gone)"
        fi
    else
        path="? (no path file in ‘${dir}’)"
        used="?"
    fi
    printf '%6s  %-10s  %s\n' "$size" "$used" "$path"
done

for dir in ${orphans[@]+"${orphans[@]}"}; do
    path="$(cat "$dir/path")"
    echo
    read -r -p "‘${path}’ is gone. [d]elete its state, [m]ove it to the project's new path, or [s]kip? " answer </dev/tty
    case "$answer" in
        d)
            rm -rf "$dir"
            echo "Deleted ‘${dir}’."
            ;;
        m)
            read -r -p "New path: " new </dev/tty
            if ! new="$(cd "$new" && pwd -P)"; then
                continue
            fi
            dest="$state_root/$(state_key "$new")"
            if [[ -e "$dest" ]]; then
                echo "‘${new}’ already has state in ‘${dest}’; skipping." >&2
                continue
            fi
            mv "$dir" "$dest"
            # Keep the old mtime: it records the last launch.
            printf '%s\n' "$new" > "$dest/path.new"
            touch -r "$dest/path" "$dest/path.new"
            mv "$dest/path.new" "$dest/path"
            echo "Moved to ‘${dest}’."
            ;;
    esac
done
